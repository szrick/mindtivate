# Copy to .env and fill in. Never commit the real .env file.
# .env is already ignored by .gitignore.

# --- Article generation (Anthropic / Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Reddit research (stage 1) ---
# No credentials needed — reads Arctic Shift (arctic-shift.photon-reddit.com),
# a free third-party archive, since Reddit's own API now gates new OAuth
# tokens behind manual approval. See docs/SETUP.md.

# --- Reddit comment posting (stage 6 only, optional) ---
# Only needed if you want the --post capability on
# scripts/pipeline/6-reddit-engagement-draft.mjs. Posting as a Reddit
# account inherently requires a real Reddit app + approved OAuth access —
# create at https://www.reddit.com/prefs/apps and see docs/SETUP.md for
# the current (manual-approval) process.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=mindtivate-research/0.1 by <your-reddit-username>

# --- Pinterest (pin creation) ---
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# --- Newsletter (Sender.net automation) ---
SENDER_API_TOKEN=
SENDER_GROUP_ID=

# --- Pages CMS / GitHub ---
# Pages CMS authenticates via GitHub OAuth in the browser — no token needed here.
# GITHUB_TOKEN is only required if the pipeline scripts commit article drafts
# directly via the GitHub API instead of through a local git checkout.
GITHUB_TOKEN=
GITHUB_REPO=szrick/mindtivate
