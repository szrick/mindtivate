---
// One horizontally-scrolling row of a single category's articles —
// modeled on SELF.com's homepage topic rows, but on the same background
// as the rest of the page (no per-category tint) so the site's palette
// stays consistent; the centered category name is what identifies each
// row instead. Scrolling works two ways at once: native touch/trackpad
// swipe (via scroll-snap) covers mobile with no JS required, while the
// prev/next buttons (desktop-only — see the max-width: 640px query below)
// page the same scroll container by one viewport-width at a time. Both
// drive the same scroll position, so they never fight each other.
import type { CollectionEntry } from 'astro:content';
import { toCategorySlug } from '../lib/categories';
import { withBase } from '../lib/url';

interface Props {
  label: string;
  articles: CollectionEntry<'articles'>[];
}

const { label, articles } = Astro.props;
const categorySlug = toCategorySlug(label);
---

<section class="category-showcase">
  <div class="container">
    <div class="showcase-header">
      <div class="showcase-header-spacer" aria-hidden="true"></div>
      <h2>{label}</h2>
      <div class="showcase-controls">
        <a href={withBase(`/category/${categorySlug}`)} class="showcase-all">See all</a>
        <div class="showcase-nav" data-nav hidden>
          <button type="button" class="nav-btn" data-prev aria-label={`Previous ${label} articles`}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <span class="nav-count" data-count aria-hidden="true"></span>
          <button type="button" class="nav-btn" data-next aria-label={`Next ${label} articles`}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <ul class="showcase-track" data-track>
      {articles.map((article) => {
        const { title, pubDate, heroImage, heroImageAlt } = article.data;
        return (
          <li class="showcase-item">
            <a href={withBase(`/articles/${article.slug}`)} class="showcase-card">
              {heroImage && (
                <img src={heroImage.src} alt={heroImageAlt ?? title} width="400" height="400" loading="lazy" />
              )}
              <span class="showcase-tag">{label}</span>
              <h3>{title}</h3>
              <time datetime={pubDate.toISOString()}>
                {pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .category-showcase {
    /* Extra padding-top (vs. bottom) gives each row clear breathing room
       before its heading — the main way rows read as separate sections
       now that they no longer sit on distinct tinted bands. */
    padding-top: clamp(2.5rem, 4vw, 4rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .showcase-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .showcase-header-spacer {
    /* Empty column that mirrors .showcase-controls' track, so the two
       1fr columns balance out and the title lands truly centered rather
       than optically shifted toward the controls. */
    justify-self: start;
  }

  .showcase-header h2 {
    margin: 0;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.8rem);
  }

  .showcase-controls {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 1.1rem;
    flex-shrink: 0;
  }

  .showcase-all {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-plum);
    white-space: nowrap;
  }

  .showcase-nav {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Without this, the class rule above (author-origin, normal weight)
     outranks the UA stylesheet's `[hidden] { display: none }` (also
     author-normal-beats-UA, regardless of selector specificity), so the
     `hidden` attribute JS toggles would otherwise get silently ignored. */
  .showcase-nav[hidden] {
    display: none;
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    border: 1px solid var(--color-plum);
    background: transparent;
    color: var(--color-plum);
    cursor: pointer;
    flex-shrink: 0;
  }

  .nav-btn:hover {
    background: var(--color-plum);
    color: var(--color-white);
  }

  .nav-btn:disabled {
    opacity: 0.35;
    cursor: default;
    background: transparent;
    color: var(--color-plum);
  }

  .nav-count {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-plum-soft);
    min-width: 2.6em;
    text-align: center;
  }

  .showcase-track {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0 0 0.5rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .showcase-track::-webkit-scrollbar {
    display: none;
  }

  .showcase-item {
    flex: 0 0 clamp(200px, 45vw, 240px);
    scroll-snap-align: start;
  }

  .showcase-card {
    display: block;
    color: inherit;
  }

  .showcase-card:hover {
    text-decoration: none;
  }

  .showcase-card img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .showcase-tag {
    display: block;
    margin-top: 0.9em;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-terracotta-dark);
  }

  .showcase-card h3 {
    margin: 0.35em 0 0.3em;
    font-size: 1rem;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .showcase-card:hover h3 {
    text-decoration: underline;
  }

  .showcase-card time {
    font-size: 0.78rem;
    color: var(--color-plum-soft);
  }

  @media (min-width: 641px) {
    .showcase-item {
      flex-basis: 240px;
    }
  }

  @media (max-width: 640px) {
    /* Below this width the row relies on native touch-scroll (helped by
       scroll-snap above) instead of the click-driven arrows — swiping is
       the expected interaction on a phone, and click targets for
       scroll-by-page arrows are fiddly at this size. */
    .showcase-nav {
      display: none !important;
    }
  }
</style>

<script>
  const showcases = document.querySelectorAll<HTMLElement>('.category-showcase');

  showcases.forEach((section) => {
    const track = section.querySelector<HTMLUListElement>('[data-track]');
    const nav = section.querySelector<HTMLElement>('[data-nav]');
    const prevBtn = section.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = section.querySelector<HTMLButtonElement>('[data-next]');
    const countEl = section.querySelector<HTMLElement>('[data-count]');
    if (!track || !nav || !prevBtn || !nextBtn || !countEl) return;

    function update() {
      const scrollable = track!.scrollWidth > track!.clientWidth + 4;
      nav!.hidden = !scrollable;
      if (!scrollable) return;

      const totalPages = Math.max(1, Math.ceil(track!.scrollWidth / track!.clientWidth));
      const currentPage = Math.min(
        totalPages,
        Math.ceil(track!.scrollLeft / track!.clientWidth) + 1,
      );
      countEl!.textContent = `${currentPage} / ${totalPages}`;
      prevBtn!.disabled = currentPage <= 1;
      nextBtn!.disabled = currentPage >= totalPages;
    }

    prevBtn.addEventListener('click', () => {
      track!.scrollBy({ left: -track!.clientWidth, behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      track!.scrollBy({ left: track!.clientWidth, behavior: 'smooth' });
    });

    let scrollTimeout: ReturnType<typeof setTimeout>;
    track.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(update, 80);
    });

    window.addEventListener('resize', update);
    update();
  });
</script>
