---
import { withBase } from '../lib/url';
import { CATEGORIES, toCategorySlug } from '../lib/categories';
import CategoryIcon from './CategoryIcon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href={withBase('/')} class="footer-logo" aria-label="Mindtivate home">
        <img src={withBase('/logo-icon-light.png')} alt="" class="footer-logo-icon" width="32" height="28" />
        <span class="footer-logo-text">Mindtivate<span class="logo-dot">.</span></span>
      </a>
      <p class="tagline">
        Evidence-checked guidance on body, food, mind, and hormones —
        sourced from what women are actually asking, not what's trending.
      </p>
      <div class="social-links">
        <a
          href="https://www.pinterest.com/mindtivate/"
          target="_blank"
          rel="noopener noreferrer"
          class="social-link"
          aria-label="Mindtivate on Pinterest"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.5" />
            <text x="12" y="16.5" text-anchor="middle" font-family="Georgia, serif" font-weight="700" font-size="13" fill="currentColor">P</text>
          </svg>
        </a>
        <a
          href="https://x.com/mindtivate"
          target="_blank"
          rel="noopener noreferrer"
          class="social-link"
          aria-label="Mindtivate on X"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.5" />
            <line x1="7.8" y1="7.8" x2="16.2" y2="16.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            <line x1="16.2" y1="7.8" x2="7.8" y2="16.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </a>
      </div>
    </div>

    <div class="footer-col">
      <h4>Categories</h4>
      <ul class="footer-categories">
        {CATEGORIES.map((c) => (
          <li>
            <a href={withBase(`/category/${toCategorySlug(c.label)}`)}>
              <CategoryIcon label={c.label} size="1rem" />
              {c.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <h4>More about us</h4>
      <ul>
        <li><a href={withBase('/about-us')}>About us</a></li>
        <li><a href={withBase('/about')}>Our approach</a></li>
        <li><a href={withBase('/affiliate-disclosure')}>Affiliate disclosure</a></li>
        <li><a href={withBase('/contact')}>Contact</a></li>
        <li><a href={withBase('/terms-and-conditions')}>Terms and conditions</a></li>
        <li><a href={withBase('/privacy-policy')}>Privacy policy</a></li>
        <li><a href={withBase('/sitemap')}>Sitemap</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-legal">
    <p>&copy; {year} Mindtivate. All rights reserved.</p>
    <p>
      Content is for informational purposes only and is not medical advice.
      Some links may be affiliate links — see our
      <a href={withBase('/affiliate-disclosure')}>disclosure</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-plum);
    color: #cfc9d6;
    margin-top: 4rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2.5rem;
    padding-top: 3.5rem;
    padding-bottom: 2.5rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.8em;
  }

  .footer-logo:hover {
    text-decoration: none;
  }

  .footer-logo-icon {
    display: block;
    width: 2rem;
    height: auto;
  }

  .footer-logo-text {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
    color: #fff;
  }

  .logo-dot {
    color: var(--color-terracotta);
  }

  .tagline {
    color: #b8b1c2;
    max-width: 36ch;
  }

  .social-links {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    color: #cfc9d6;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .social-link:hover {
    color: #fff;
    text-decoration: none;
  }

  .footer-col h4 {
    font-family: var(--font-body);
    color: #fff;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1em;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7em;
  }

  .footer-col a {
    color: #b8b1c2;
    font-size: 0.92rem;
  }

  .footer-col a:hover {
    color: #fff;
  }

  .footer-categories a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-categories :global(.category-icon) {
    flex-shrink: 0;
    color: #9a93a6;
    transition: color 0.15s ease;
  }

  .footer-categories a:hover :global(.category-icon) {
    color: var(--color-terracotta);
  }

  .footer-legal {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: #8a8393;
  }

  .footer-legal a {
    color: #a89fb5;
  }

  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
