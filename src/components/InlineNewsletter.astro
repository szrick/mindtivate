---
// Two of these are inserted client-side into the middle third of an
// article's body (see the <script> below) — one editorial pattern
// borrowed from SELF.com's inline newsletter boxes, shortened and
// adapted to Mindtivate's broader (not single-topic) newsletter.
import { getEntry } from 'astro:content';
import { withBase } from '../lib/url';

const settings = await getEntry('settings', 'site');
const formAction = settings?.data.senderFormAction ?? '#';
---

<template data-inline-newsletter-template>
  <aside class="inline-newsletter" aria-label="Newsletter signup">
    <p class="inline-newsletter-eyebrow">Mindtivate Weekly</p>
    <p class="inline-newsletter-copy">
      Not just eating healthy — tips on fitness, hormones, beauty, relationships,
      and everything else on the site, delivered to your inbox each week.
    </p>
    <form class="inline-newsletter-form" action={formAction} method="post" target="_blank">
      <label class="visually-hidden">Email address</label>
      <input type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
      <button type="submit" class="btn btn-primary">Sign up</button>
    </form>
    <p class="inline-newsletter-consent">
      By signing up, you agree to our <a href={withBase('/privacy-policy')}>privacy policy</a>.
    </p>
  </aside>
</template>

<style>
  .inline-newsletter {
    margin: 2.5rem 0;
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-cream-deep);
  }

  .inline-newsletter-eyebrow {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-plum);
    margin: 0 0 0.5em;
  }

  .inline-newsletter-copy {
    color: var(--color-plum-soft);
    font-size: 0.95rem;
    margin: 0 0 1.1em;
  }

  .inline-newsletter-form {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 0 0 0.8em;
  }

  .inline-newsletter-form input {
    flex: 1 1 200px;
    padding: 0.75em 1.1em;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-white);
    font-family: var(--font-body);
    font-size: 0.92rem;
  }

  .inline-newsletter-form input:focus-visible {
    outline: 3px solid var(--color-terracotta);
  }

  .inline-newsletter-form .btn {
    padding: 0.7em 1.4em;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .inline-newsletter-consent {
    font-size: 0.78rem;
    color: var(--color-plum-soft);
    margin: 0;
  }

  .inline-newsletter-consent a {
    color: var(--color-plum-soft);
  }
</style>

<script>
  function pickAnchor(blocks: Element[], targetIndex: number, taken: Set<Element>): Element | null {
    for (let i = targetIndex; i < blocks.length; i++) {
      const el = blocks[i];
      if (taken.has(el)) continue;
      if (['P', 'UL', 'OL', 'BLOCKQUOTE'].includes(el.tagName)) return el;
    }
    return blocks.find((el) => !taken.has(el)) ?? null;
  }

  function insertInlineNewsletters() {
    const template = document.querySelector<HTMLTemplateElement>('[data-inline-newsletter-template]');
    const prose = document.querySelector<HTMLElement>('.prose');
    if (!template || !prose) return;

    const blocks = Array.from(prose.children) as Element[];
    // Skip short articles — not enough content to justify interrupting twice.
    if (blocks.length < 6) return;

    const targets = [Math.floor(blocks.length / 3), Math.floor((blocks.length * 2) / 3)];
    const taken = new Set<Element>();

    targets.forEach((targetIndex, i) => {
      const anchor = pickAnchor(blocks, targetIndex, taken);
      if (!anchor) return;
      taken.add(anchor);

      const clone = template.content.cloneNode(true) as DocumentFragment;
      const input = clone.querySelector('input');
      const label = clone.querySelector('label');
      if (input && label) {
        const id = `inline-newsletter-email-${i}`;
        input.id = id;
        label.setAttribute('for', id);
      }
      anchor.after(clone);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', insertInlineNewsletters);
  } else {
    insertInlineNewsletters();
  }
</script>
