---
// Client-side-inserted copy of NewsletterBox, placed at the middle of an
// article's body (see the <script> below) — one editorial pattern
// borrowed from SELF.com's inline newsletter boxes. The bottom-of-article
// newsletter box (rendered directly in ArticleLayout.astro) uses the same
// NewsletterBox component so both placements are guaranteed identical.
import NewsletterBox from './NewsletterBox.astro';
---

<template data-inline-newsletter-template>
  <NewsletterBox id="inline-newsletter-email-mid" />
</template>

<script>
  function pickAnchor(blocks: Element[], targetIndex: number): Element | null {
    for (let i = targetIndex; i < blocks.length; i++) {
      const el = blocks[i];
      if (['P', 'UL', 'OL', 'BLOCKQUOTE'].includes(el.tagName)) return el;
    }
    return blocks[targetIndex] ?? null;
  }

  function insertInlineNewsletter() {
    const template = document.querySelector<HTMLTemplateElement>('[data-inline-newsletter-template]');
    const prose = document.querySelector<HTMLElement>('.prose');
    if (!template || !prose) return;

    const blocks = Array.from(prose.children) as Element[];
    // Skip short articles — not enough content on either side to justify a break.
    if (blocks.length < 4) return;

    const anchor = pickAnchor(blocks, Math.floor(blocks.length / 2));
    if (!anchor) return;

    const clone = template.content.cloneNode(true) as DocumentFragment;
    anchor.after(clone);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', insertInlineNewsletter);
  } else {
    insertInlineNewsletter();
  }
</script>
