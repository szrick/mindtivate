---
interface Props {
  label: string;
  size?: string;
  color?: string;
}

const { label, size = '1.9rem', color } = Astro.props;
const iconStyle = `width:${size};height:${size};${color ? `color:${color};` : ''}`;
---

<svg class="category-icon" viewBox="0 0 24 24" aria-hidden="true" style={iconStyle}>
  {label === 'Body' && (
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="9" width="4" height="6" rx="1" />
      <rect x="18" y="9" width="4" height="6" rx="1" />
      <line x1="6" y1="12" x2="18" y2="12" />
    </g>
  )}
  {label === 'Food' && (
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <ellipse cx="12" cy="13.5" rx="7" ry="6.5" />
      <line x1="12" y1="6.5" x2="12" y2="3.5" />
      <ellipse cx="15" cy="4.3" rx="2.2" ry="1.3" transform="rotate(-30 15 4.3)" />
    </g>
  )}
  {label === 'Mind' && (
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 16a4 4 0 0 1 0-8 5 5 0 0 1 9.6-1.5A4.5 4.5 0 0 1 18 15.5" />
      <line x1="6" y1="16" x2="18" y2="15.9" />
    </g>
  )}
  {label === 'Hormones' && (
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 2 C7 8, 4 12, 4 15.5 A8 8 0 0 0 20 15.5 C20 12, 17 8, 12 2 Z"
    />
  )}
  {label === 'Love' && (
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
    />
  )}
  {label === 'Beauty' && (
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 12 Q12 4 22 12 Q12 20 2 12 Z" />
      <circle cx="12" cy="12" r="2.6" />
      <line x1="4" y1="6" x2="6" y2="8.5" />
      <line x1="9" y1="3.2" x2="10" y2="6" />
      <line x1="15" y1="3.2" x2="14" y2="6" />
    </g>
  )}
  {label === 'Sleep' && (
    <g fill="currentColor" stroke="none">
      <circle cx="11" cy="12" r="8" />
      <circle cx="15" cy="9" r="7" fill="var(--color-cream)" />
      <circle cx="19" cy="5.5" r="0.9" />
      <circle cx="21" cy="9" r="0.6" />
    </g>
  )}
  {label === 'Life Stages' && (
    <g fill="currentColor" stroke="none">
      <rect x="3" y="16" width="4" height="5" rx="0.8" />
      <rect x="10" y="11" width="4" height="10" rx="0.8" />
      <rect x="17" y="5" width="4" height="16" rx="0.8" />
    </g>
  )}
</svg>

<style>
  .category-icon {
    flex-shrink: 0;
    color: inherit;
  }
</style>
