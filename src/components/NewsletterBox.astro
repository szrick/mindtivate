---
// Shared markup for the boxed newsletter CTA used at both the middle and
// the bottom of an article. Both placements render this exact same
// component so they're guaranteed to look identical — including under a
// browser's own forced-dark rendering, which can otherwise treat two
// separately-styled elements differently even when their CSS colors
// match on paper.
import { withBase } from '../lib/url';
---

<aside class="inline-newsletter" aria-label="Newsletter signup">
  <p class="inline-newsletter-eyebrow">Mindtivate Insights</p>
  <p class="inline-newsletter-copy">
    Health, fitness, beauty, hormones, relationships, and practical tips
    for living well, delivered to your inbox free.
  </p>
  <!--
    Posts to /api/subscribe, a Cloudflare Worker route (see
    worker/index.ts) that adds the contact via the Resend API — no
    third-party hosted form or iframe. See src/lib/newsletter.ts for the
    fetch-based submit handling (shared with NewsletterSignup.astro).
  -->
  <form class="inline-newsletter-form" data-newsletter-form method="post" action={withBase('/api/subscribe')} novalidate>
    <div class="honeypot" aria-hidden="true">
      <label for="inline-newsletter-company">Company</label>
      <input id="inline-newsletter-company" name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <label for="inline-newsletter-email" class="visually-hidden">Email address</label>
    <input
      id="inline-newsletter-email"
      type="email"
      name="email"
      required
      placeholder="you@example.com"
      autocomplete="email"
    />
    <button type="submit" class="btn btn-primary">Sign up</button>
  </form>
  <p class="inline-newsletter-status" data-newsletter-status role="status" aria-live="polite" hidden></p>
  <p class="inline-newsletter-consent">
    By signing up, you agree to our <a href={withBase('/privacy-policy')}>privacy policy</a>.
  </p>
</aside>

<style>
  .inline-newsletter {
    max-width: 720px;
    margin: 2.5rem auto;
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-cream-deep);
  }

  .inline-newsletter-eyebrow {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-plum);
    margin: 0 0 0.5em;
  }

  .inline-newsletter-copy {
    color: var(--color-plum-soft);
    font-size: 0.95rem;
    margin: 0 0 1.1em;
  }

  .inline-newsletter-form {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 0 0 0.8em;
  }

  /* Without this, the class rule above (author-origin, normal weight)
     outranks the UA stylesheet's `[hidden] { display: none }` (also
     author-normal-beats-UA, regardless of selector specificity), so
     src/lib/newsletter.ts setting form.hidden = true on a successful
     signup would silently do nothing — the form stays visible right
     above the new status message instead of being replaced by it. */
  .inline-newsletter-form[hidden] {
    display: none;
  }

  .inline-newsletter-form input {
    flex: 1 1 200px;
    -webkit-appearance: none;
    appearance: none;
    padding: 0.75em 1.1em;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-white);
    font-family: var(--font-body);
    font-size: 0.92rem;
  }

  .inline-newsletter-form input:focus-visible {
    outline: 3px solid var(--color-terracotta);
  }

  /* Chrome/Edge force their own autofill background (a pale blue/yellow)
     that a plain `background` rule can't override — this is the standard
     workaround: an inset box-shadow the size of the field paints over it,
     and -webkit-text-fill-color re-asserts the text color autofill also
     otherwise overrides. */
  .inline-newsletter-form input:-webkit-autofill,
  .inline-newsletter-form input:-webkit-autofill:hover,
  .inline-newsletter-form input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px var(--color-white) inset;
    -webkit-text-fill-color: var(--color-plum);
  }

  .inline-newsletter-form .btn {
    padding: 0.7em 1.4em;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .inline-newsletter-status {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-sage-dark);
    margin: 0 0 0.6em;
  }

  .inline-newsletter-consent {
    font-size: 0.78rem;
    color: var(--color-plum-soft);
    margin: 0;
  }

  .inline-newsletter-consent a {
    color: var(--color-plum-soft);
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
</style>

<script>
  import { initNewsletterForms } from '../lib/newsletter';
  initNewsletterForms();
</script>
