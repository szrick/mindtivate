---
// Shared markup for the boxed newsletter CTA used at both the middle and
// the bottom of an article. Both placements render this exact same
// component so they're guaranteed to look identical — including under a
// browser's own forced-dark rendering, which can otherwise treat two
// separately-styled elements differently even when their CSS colors
// match on paper.
import { getEntry } from 'astro:content';
import { withBase } from '../lib/url';

const settings = await getEntry('settings', 'site');
const formAction = settings?.data.senderFormAction ?? '#';
---

<aside class="inline-newsletter" aria-label="Newsletter signup">
  <p class="inline-newsletter-eyebrow">Mindtivate Insights</p>
  <p class="inline-newsletter-copy">
    Health, fitness, beauty, hormones, relationships, and practical tips
    for living well, delivered to your inbox free.
  </p>
  <iframe src={formAction} title="Subscribe to Mindtivate Insights" class="inline-newsletter-iframe" loading="lazy"></iframe>
  <p class="inline-newsletter-consent">
    Trouble loading the form?
    <a href={formAction} target="_blank" rel="noopener noreferrer">Open it in a new tab</a>
    instead. By signing up, you agree to our <a href={withBase('/privacy-policy')}>privacy policy</a>.
  </p>
</aside>

<style>
  .inline-newsletter {
    max-width: 720px;
    margin: 2.5rem auto;
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-cream-deep);
  }

  .inline-newsletter-eyebrow {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-plum);
    margin: 0 0 0.5em;
  }

  .inline-newsletter-copy {
    color: var(--color-plum-soft);
    font-size: 0.95rem;
    margin: 0 0 1.1em;
  }

  .inline-newsletter-iframe {
    display: block;
    width: 100%;
    max-width: 420px;
    height: 540px;
    margin: 0 0 0.8em;
    border: none;
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .inline-newsletter-consent {
    font-size: 0.78rem;
    color: var(--color-plum-soft);
    margin: 0;
  }

  .inline-newsletter-consent a {
    color: var(--color-plum-soft);
  }
</style>
