---
import { getCollection, type CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { category } = article.data;

const others = await getCollection(
  'articles',
  (entry) => entry.data.status === 'published' && !entry.data.draft && entry.slug !== article.slug,
);

const byRecency = (a: CollectionEntry<'articles'>, b: CollectionEntry<'articles'>) =>
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf();

// Same-category articles first (most relevant), then fill any remaining
// slots with the site's other most recent articles.
const sameCategory = others.filter((a) => a.data.category === category).sort(byRecency);
const rest = others.filter((a) => a.data.category !== category).sort(byRecency);
const relatedArticles = [...sameCategory, ...rest].slice(0, 5);
---

{relatedArticles.length > 0 && (
  <section class="section container related-articles">
    <p class="eyebrow">Keep reading</p>
    <h2>Related articles</h2>
    <ul class="related-articles-list">
      {relatedArticles.map((related) => (
        <li>
          <a href={withBase(`/articles/${related.slug}`)}>{related.data.title}</a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .related-articles {
    padding-top: 0;
    padding-bottom: 1rem;
  }

  .related-articles-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    max-width: 720px;
  }

  .related-articles-list li {
    border-bottom: 1px solid var(--color-border);
  }

  .related-articles-list li:first-child {
    border-top: 1px solid var(--color-border);
  }

  .related-articles-list a {
    display: block;
    padding: 0.95em 0.1em;
    color: var(--color-plum);
    font-weight: 600;
  }

  .related-articles-list a:hover {
    color: var(--color-terracotta-dark);
    text-decoration: none;
  }
</style>
