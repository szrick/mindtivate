---
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
}

const { title, description, image, article = false } = Astro.props;
const siteName = 'Mindtivate';
// Article titles skip the "| Mindtivate" suffix -- a real, well-known
// article title is already descriptive enough for a search snippet on
// its own, and appending 13 more characters routinely pushed already-
// long titles well past the ~60-character point search engines start
// truncating <title> tags at (flagged by an SEO crawl: title_tag_too_long).
// Non-article pages (nearly all short, generic labels like "Contact" or
// "Search") keep the suffix for brand context.
const fullTitle = article || title === siteName ? title : `${title} | ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : new URL(withBase('/og-default.svg'), Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:url" content={canonicalURL} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
