---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { toCategorySlug } from '../lib/categories';
import { withBase } from '../lib/url';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, description, pubDate, category, heroImage, heroImageAlt } = article.data;
const categorySlug = toCategorySlug(category);
const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<div class="article-card card">
  {heroImage && (
    <Image
      src={heroImage}
      alt={heroImageAlt ?? title}
      loading="lazy"
      widths={[280, 480, 600]}
      sizes="(max-width: 640px) 100vw, 360px"
      quality={75}
    />
  )}
  <div class="article-card-body">
    <a href={withBase(`/category/${categorySlug}`)} class="tag category-link">{category}</a>
    <h3><a href={withBase(`/articles/${article.slug}`)} class="card-link">{title}</a></h3>
    <p>{description}</p>
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
  </div>
</div>

<style>
  .article-card {
    position: relative;
    color: inherit;
  }

  .article-card img {
    width: 100%;
    /* height: auto is required alongside aspect-ratio here -- without it,
       the <img>'s own width/height HTML attributes (astro:assets sets
       these to the source photo's full intrinsic size) apply as a
       presentational hint that gives `height` a definite value, which
       silently defeats aspect-ratio's auto-height computation (it only
       kicks in when height is auto). See ArticleLayout.astro's .article-hero
       for the same fix with more detail. */
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 0;
  }

  .article-card-body {
    padding: 1.4rem;
  }

  .article-card-body h3 {
    margin: 0.6em 0 0.4em;
  }

  .article-card-body p {
    font-size: 0.95rem;
    margin-bottom: 0.8em;
  }

  .article-card-body time {
    font-size: 0.82rem;
    color: var(--color-plum-soft);
  }

  .category-link {
    position: relative;
    z-index: 2;
  }

  /* "Stretched link" pattern: the title link's ::after covers the whole
     card so the entire card is clickable, while the category tag above
     stays independently clickable via its own higher z-index. */
  .card-link {
    color: inherit;
  }

  .card-link:hover {
    text-decoration: none;
  }

  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
</style>
