---
import { getEntry } from 'astro:content';
import { withBase } from '../lib/url';

const settings = await getEntry('settings', 'site');
const headline = settings?.data.newsletterHeadline ?? 'Mindtivate Insights';
const subtext =
  settings?.data.newsletterSubtext ??
  'Health, fitness, beauty, hormones, relationships, and practical tips for living well, delivered to your inbox free.';
const formAction = settings?.data.senderFormAction ?? '#';
---

<section id="newsletter" class="newsletter">
  <div class="container newsletter-inner">
    <div class="newsletter-copy">
      <h2>{headline}</h2>
      <p>{subtext}</p>
    </div>

    <div class="newsletter-form-wrap">
      <!--
        Sender.net hosted-form endpoint. Configure `senderFormAction` in
        src/content/settings/site.yml (or via Pages CMS → Site settings) with
        the form's subscribe URL from your Sender account. Sender then owns
        double opt-in, tagging, and the automation sequence — see
        docs/CONTENT_PIPELINE.md.
      -->
      <form class="newsletter-form" action={formAction} method="post" target="_blank">
        <label for="newsletter-email" class="visually-hidden">Email address</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          required
          placeholder="you@example.com"
          autocomplete="email"
        />
        <button type="submit" class="btn btn-primary">Sign up</button>
      </form>
      <p class="newsletter-consent">
        By signing up, you agree to our <a href={withBase('/privacy-policy')}>privacy policy</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .newsletter {
    background: var(--color-cream-deep);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-plum);
    padding: clamp(2rem, 4vw, 3.5rem);
    margin: 0 1.5rem;
  }

  .newsletter-inner {
    max-width: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .newsletter-copy {
    max-width: 480px;
  }

  .newsletter-copy h2 {
    color: var(--color-plum);
  }

  .newsletter-copy p {
    color: var(--color-plum-soft);
  }

  .newsletter-form {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .newsletter-form input {
    -webkit-appearance: none;
    appearance: none;
    padding: 0.85em 1.1em;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-white);
    min-width: 240px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-plum);
  }

  .newsletter-form input:focus-visible {
    outline: 3px solid var(--color-terracotta);
  }

  .newsletter-consent {
    margin: 0.6em 0 0;
    font-size: 0.78rem;
    color: var(--color-plum-soft);
  }

  .newsletter-consent a {
    color: var(--color-plum-soft);
  }
</style>
