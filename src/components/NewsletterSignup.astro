---
import { getEntry } from 'astro:content';
import { withBase } from '../lib/url';

const settings = await getEntry('settings', 'site');
const headline = settings?.data.newsletterHeadline ?? 'Mindtivate Insights';
const subtext =
  settings?.data.newsletterSubtext ??
  'Health, fitness, beauty, hormones, relationships, and practical tips for living well, delivered to your inbox free.';
const formAction = settings?.data.senderFormAction ?? '#';
---

<section id="newsletter" class="newsletter">
  <div class="container newsletter-inner">
    <div class="newsletter-copy">
      <h2>{headline}</h2>
      <p>{subtext}</p>
    </div>

    <div class="newsletter-form-wrap">
      <!--
        Sender.net's forms on this account are hosted pages (a URL + QR
        code from the dashboard), not a POST endpoint you can submit an
        inline <form> to — so this links out to that hosted page rather
        than collecting the email on-site. Configure `senderFormAction` in
        src/content/settings/site.yml (or via Pages CMS → Site settings)
        with that form's URL from your Sender account. Sender then owns
        double opt-in, tagging, and the automation sequence — see
        docs/CONTENT_PIPELINE.md.
      -->
      <a href={formAction} target="_blank" rel="noopener noreferrer" class="btn btn-primary newsletter-cta">
        Sign up free
      </a>
      <p class="newsletter-consent">
        Opens Sender's signup page in a new tab. By signing up, you agree to our
        <a href={withBase('/privacy-policy')}>privacy policy</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .newsletter {
    background: var(--color-cream-deep);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-plum);
    padding: clamp(2rem, 4vw, 3.5rem);
    margin: 0 1.5rem;
  }

  .newsletter-inner {
    max-width: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .newsletter-copy {
    max-width: 480px;
  }

  .newsletter-copy h2 {
    color: var(--color-plum);
  }

  .newsletter-copy p {
    color: var(--color-plum-soft);
  }

  .newsletter-cta {
    white-space: nowrap;
  }

  .newsletter-consent {
    margin: 0.6em 0 0;
    font-size: 0.78rem;
    color: var(--color-plum-soft);
  }

  .newsletter-consent a {
    color: var(--color-plum-soft);
  }
</style>
