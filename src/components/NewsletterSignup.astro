---
import { getEntry } from 'astro:content';
import { withBase } from '../lib/url';

const settings = await getEntry('settings', 'site');
const headline = settings?.data.newsletterHeadline ?? 'Mindtivate Insights';
const subtext =
  settings?.data.newsletterSubtext ??
  'Health, fitness, beauty, hormones, relationships, and practical tips for living well, delivered to your inbox free.';
---

<section id="newsletter" class="newsletter">
  <div class="container newsletter-inner">
    <div class="newsletter-copy">
      <h2>{headline}</h2>
      <p>{subtext}</p>
    </div>

    <div class="newsletter-form-wrap">
      <!--
        Posts to /api/subscribe, a Cloudflare Worker route (see
        worker/index.ts) that adds the contact via the Resend API — no
        third-party hosted form or iframe. method="post" action="..." is
        a real fallback for when JS is unavailable; src/lib/newsletter.ts
        intercepts the submit normally for an inline result instead of a
        page navigation.
      -->
      <form class="newsletter-form" data-newsletter-form method="post" action={withBase('/api/subscribe')} novalidate>
        <div class="honeypot" aria-hidden="true">
          <label for="newsletter-company">Company</label>
          <input id="newsletter-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <label for="newsletter-email" class="visually-hidden">Email address</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          required
          placeholder="you@example.com"
          autocomplete="email"
        />
        <button type="submit" class="btn btn-primary">Sign up</button>
      </form>
      <p class="newsletter-status" data-newsletter-status role="status" aria-live="polite" hidden></p>
      <p class="newsletter-consent">
        By signing up, you agree to our <a href={withBase('/privacy-policy')}>privacy policy</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .newsletter {
    background: var(--color-cream-deep);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-plum);
    padding: clamp(2rem, 4vw, 3.5rem);
    margin: 0 1.5rem;
  }

  .newsletter-inner {
    max-width: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .newsletter-copy {
    max-width: 480px;
  }

  .newsletter-copy h2 {
    color: var(--color-plum);
  }

  .newsletter-copy p {
    color: var(--color-plum-soft);
  }

  .newsletter-form {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .newsletter-form input {
    -webkit-appearance: none;
    appearance: none;
    padding: 0.85em 1.1em;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-white);
    min-width: 240px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-plum);
  }

  .newsletter-form input:focus-visible {
    outline: 3px solid var(--color-terracotta);
  }

  .newsletter-status {
    margin: 0.6em 0 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-sage-dark);
  }

  .newsletter-consent {
    margin: 0.6em 0 0;
    font-size: 0.78rem;
    color: var(--color-plum-soft);
  }

  .newsletter-consent a {
    color: var(--color-plum-soft);
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
</style>

<script>
  import { initNewsletterForms } from '../lib/newsletter';
  initNewsletterForms();
</script>
