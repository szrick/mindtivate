---
import { getEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
  id?: string;
}

// Defaults to "newsletter" so existing #newsletter anchor links (e.g.
// /newsletter/confirm-error.astro's "sign up again" link) keep working
// unchanged. Pass a different id when rendering more than one instance
// on the same page — duplicate ids on the section and its inputs would
// otherwise be invalid HTML and break label/input association.
const { id = 'newsletter' } = Astro.props;

const settings = await getEntry('settings', 'site');
const headline = settings?.data.newsletterHeadline ?? 'Mindtivate Insights';
const subtext =
  settings?.data.newsletterSubtext ??
  'Health, fitness, beauty, hormones, relationships, and practical tips for living well, delivered to your inbox free.';
---

<section id={id} class="newsletter">
  <div class="container newsletter-inner">
    <div class="newsletter-copy">
      <h2>{headline}</h2>
      <p>{subtext}</p>
    </div>

    <div class="newsletter-form-wrap">
      <!--
        Posts to /api/subscribe, a Cloudflare Worker route (see
        worker/index.ts) that adds the contact via the Resend API — no
        third-party hosted form or iframe. method="post" action="..." is
        a real fallback for when JS is unavailable; src/lib/newsletter.ts
        intercepts the submit normally for an inline result instead of a
        page navigation.
      -->
      <form class="newsletter-form" data-newsletter-form method="post" action={withBase('/api/subscribe')} novalidate>
        <div class="honeypot" aria-hidden="true">
          <label for={`${id}-company`}>Company</label>
          <input id={`${id}-company`} name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <label for={`${id}-email`} class="visually-hidden">Email address</label>
        <input
          id={`${id}-email`}
          name="email"
          type="email"
          required
          placeholder="you@example.com"
          autocomplete="email"
        />
        <button type="submit" class="btn btn-primary">Sign up</button>
      </form>
      <p class="newsletter-status" data-newsletter-status role="status" aria-live="polite" hidden></p>
      <p class="newsletter-consent">
        By signing up, you agree to our <a href={withBase('/privacy-policy')}>privacy policy</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .newsletter {
    background: var(--color-cream-deep);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-plum);
    padding: clamp(2rem, 4vw, 3.5rem);
    margin: 0 1.5rem;
  }

  .newsletter-inner {
    max-width: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .newsletter-copy {
    max-width: 480px;
  }

  /* Without an explicit width, this column's size is normally driven by
     the form's input+button row. Once the form is hidden after a
     successful signup, only the (much narrower) status/consent text is
     left — with no constraint, that text's unwrapped preferred width can
     exceed the space remaining next to .newsletter-copy, which pushes the
     whole column onto its own line via flex-wrap instead of just
     wrapping its own text within the space it had. Constraining the
     column's width keeps it in place and lets the text wrap normally. */
  .newsletter-form-wrap {
    flex: 1 1 320px;
    max-width: 380px;
  }

  .newsletter-copy h2 {
    color: var(--color-plum);
  }

  .newsletter-copy p {
    color: var(--color-plum-soft);
  }

  .newsletter-form {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  /* Without this, the class rule above (author-origin, normal weight)
     outranks the UA stylesheet's `[hidden] { display: none }` (also
     author-normal-beats-UA, regardless of selector specificity), so
     src/lib/newsletter.ts setting form.hidden = true on a successful
     signup would silently do nothing — the form stays visible right
     above the new status message instead of being replaced by it. */
  .newsletter-form[hidden] {
    display: none;
  }

  .newsletter-form input {
    -webkit-appearance: none;
    appearance: none;
    padding: 0.85em 1.1em;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-white);
    min-width: 240px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-plum);
  }

  .newsletter-form input:focus-visible {
    outline: 3px solid var(--color-terracotta);
  }

  /* Chrome/Edge force their own autofill background (a pale blue/yellow)
     that a plain `background` rule can't override — this is the standard
     workaround: an inset box-shadow the size of the field paints over it,
     and -webkit-text-fill-color re-asserts the text color autofill also
     otherwise overrides. */
  .newsletter-form input:-webkit-autofill,
  .newsletter-form input:-webkit-autofill:hover,
  .newsletter-form input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px var(--color-white) inset;
    -webkit-text-fill-color: var(--color-plum);
  }

  .newsletter-status {
    margin: 0.6em 0 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-sage-dark);
  }

  .newsletter-consent {
    margin: 0.6em 0 0;
    font-size: 0.78rem;
    color: var(--color-plum-soft);
  }

  .newsletter-consent a {
    color: var(--color-plum-soft);
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
</style>

<script>
  import { initNewsletterForms } from '../lib/newsletter';
  initNewsletterForms();
</script>
