---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
  articles: CollectionEntry<'articles'>[];
}

const { articles } = Astro.props;
---

{articles.length > 0 && (
  <section class="hero-slider" data-slider aria-roledescription="carousel" aria-label="Featured articles">
    <div class="slider-viewport">
      <ul class="slider-track" data-track>
        {articles.map((article, i) => (
          <li
            class="slide"
            data-slide
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${articles.length}`}
            aria-hidden={i === 0 ? 'false' : 'true'}
          >
            <a href={withBase(`/articles/${article.slug}`)} class="slide-link" tabindex={i === 0 ? '0' : '-1'}>
              {article.data.heroImage && (
                <img
                  src={article.data.heroImage.src}
                  alt={article.data.heroImageAlt ?? article.data.title}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              )}
              <div class="slide-scrim"></div>
              <div class="slide-copy">
                <span class="tag">{article.data.category}</span>
                <h2>{article.data.title}</h2>
                <p>{article.data.description}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>

    {articles.length > 1 && (
      <>
        <button type="button" class="slider-arrow prev" data-prev aria-label="Previous slide">‹</button>
        <button type="button" class="slider-arrow next" data-next aria-label="Next slide">›</button>
        <div class="slider-dots" data-dots role="tablist" aria-label="Choose slide">
          {articles.map((_, i) => (
            <button
              type="button"
              class="slider-dot"
              data-dot
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={`Go to slide ${i + 1}`}
            ></button>
          ))}
        </div>
      </>
    )}
  </section>
)}

<style>
  .hero-slider {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .slider-viewport {
    overflow: hidden;
  }

  .slider-track {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    transition: transform 0.5s ease;
  }

  .slide {
    flex: 0 0 100%;
    min-width: 0;
  }

  .slide-link {
    position: relative;
    display: block;
    aspect-ratio: 16 / 7;
    color: #fff;
  }

  .slide-link:hover {
    text-decoration: none;
  }

  .slide-link img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .slide-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(47, 42, 51, 0.82) 0%, rgba(47, 42, 51, 0.15) 55%, rgba(47, 42, 51, 0) 100%);
  }

  .slide-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    max-width: 640px;
  }

  .slide-copy .tag {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
  }

  .slide-copy h2 {
    color: #fff;
    margin: 0.5em 0 0.3em;
    font-size: clamp(1.3rem, 1.1rem + 1.2vw, 2rem);
  }

  .slide-copy p {
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.85);
    color: var(--color-plum);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease;
  }

  .slider-arrow:hover {
    background: #fff;
  }

  .slider-arrow.prev {
    left: 1rem;
  }

  .slider-arrow.next {
    right: 1rem;
  }

  .slider-dots {
    position: absolute;
    bottom: 1.25rem;
    right: clamp(1.25rem, 3vw, 2.5rem);
    display: flex;
    gap: 0.5rem;
  }

  .slider-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    padding: 0;
  }

  .slider-dot[aria-selected='true'] {
    background: #fff;
    width: 1.5rem;
    border-radius: 999px;
  }

  @media (max-width: 640px) {
    .slider-arrow {
      display: none;
    }
  }
</style>

<script>
  function initSlider(slider: HTMLElement) {
    const track = slider.querySelector<HTMLElement>('[data-track]');
    const slides = Array.from(slider.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(slider.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const prevBtn = slider.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = slider.querySelector<HTMLButtonElement>('[data-next]');
    if (!track || slides.length === 0) return;

    let index = 0;
    let timer: number | undefined;

    function render() {
      track!.style.transform = `translateX(-${index * 100}%)`;
      slides.forEach((slide, i) => {
        const link = slide.querySelector('a');
        const isActive = i === index;
        slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        link?.setAttribute('tabindex', isActive ? '0' : '-1');
      });
      dots.forEach((dot, i) => dot.setAttribute('aria-selected', i === index ? 'true' : 'false'));
    }

    function goTo(i: number) {
      index = (i + slides.length) % slides.length;
      render();
    }

    function next() {
      goTo(index + 1);
    }

    function prev() {
      goTo(index - 1);
    }

    function startAutoplay() {
      stopAutoplay();
      if (slides.length > 1) {
        timer = window.setInterval(next, 6000);
      }
    }

    function stopAutoplay() {
      if (timer) window.clearInterval(timer);
    }

    nextBtn?.addEventListener('click', () => {
      next();
      startAutoplay();
    });
    prevBtn?.addEventListener('click', () => {
      prev();
      startAutoplay();
    });
    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        goTo(i);
        startAutoplay();
      })
    );

    slider.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight') {
        next();
        startAutoplay();
      } else if (e.key === 'ArrowLeft') {
        prev();
        startAutoplay();
      }
    });

    slider.addEventListener('mouseenter', stopAutoplay);
    slider.addEventListener('mouseleave', startAutoplay);
    slider.addEventListener('focusin', stopAutoplay);
    slider.addEventListener('focusout', startAutoplay);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopAutoplay();
      else startAutoplay();
    });

    render();
    startAutoplay();
  }

  document.querySelectorAll<HTMLElement>('[data-slider]').forEach(initSlider);
</script>
