---
import { CATEGORIES, toCategorySlug } from '../lib/categories';
import { withBase } from '../lib/url';
import CategoryIcon from './CategoryIcon.astro';

// The new category labels (Body, Food, Mind, etc.) are much shorter than
// the old ones (Strength Training, Bodyweight Fitness), so all 8 fit in
// the header without the overflow the old longer labels caused at 6
// items — verified at 1280px before shipping this. If categories grow
// longer/more numerous again, re-check for overflow before assuming it
// still fits.
const navCategories = CATEGORIES;
---

<header class="site-header">
  <div class="container header-inner">
    <div class="header-left">
      <button
        type="button"
        class="menu-toggle"
        data-menu-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>

    <a href={withBase('/')} class="logo" aria-label="Mindtivate home">
      <img src={withBase('/logo-icon.png')} alt="" class="logo-icon" width="32" height="28" />
      <span class="logo-text">Mindtivate<span class="logo-dot">.</span></span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {navCategories.map((c) => (
          <li>
            <a href={withBase(`/category/${toCategorySlug(c.label)}`)}>
              <CategoryIcon label={c.label} size="1.15rem" />
              {c.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-icons">
      <a href={withBase('/saved')} class="bookmark-link" data-bookmark-link aria-label="Saved articles">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            d="M6 3.5h12a1 1 0 0 1 1 1V21l-7-4-7 4V4.5a1 1 0 0 1 1-1Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
          />
        </svg>
        <span class="bookmark-count" data-bookmark-count hidden></span>
      </a>

      <button
        type="button"
        class="search-toggle"
        data-search-toggle
        aria-label="Search"
        aria-expanded="false"
        aria-controls="header-search-bar"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="7" fill="none" stroke="currentColor" stroke-width="1.8" />
          <line x1="15.8" y1="15.8" x2="21" y2="21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="header-search-bar" class="header-search-bar" data-header-search-bar hidden>
    <form class="header-search-form container" action={withBase('/search')} method="get">
      <label for="header-search-input" class="visually-hidden">Search articles</label>
      <input
        id="header-search-input"
        name="q"
        type="search"
        placeholder="Search articles by keyword…"
        autocomplete="off"
        data-search-input
      />
      <button type="submit" class="btn btn-primary">Search</button>
    </form>
  </div>

  <nav id="mobile-menu" class="mobile-menu" data-mobile-menu aria-label="Categories" hidden>
    <ul>
      {navCategories.map((c) => (
        <li>
          <a href={withBase(`/category/${toCategorySlug(c.label)}`)}>
            <CategoryIcon label={c.label} size="1.15rem" />
            {c.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .header-left {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
    flex-shrink: 0;
  }

  .menu-toggle .bar {
    display: block;
    width: 1.4rem;
    height: 2px;
    border-radius: 2px;
    /* Neutral grey, not the plum-tinted --color-plum-soft — a chrome
       control like this shouldn't compete with the page's actual
       content for attention. */
    background: var(--color-gray-50);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--color-plum);
    letter-spacing: -0.01em;
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo-icon {
    display: block;
    width: 2.3rem;
    height: auto;
  }

  .logo-dot {
    color: var(--color-terracotta);
  }

  .primary-nav {
    flex: 1;
    min-width: 0;
  }

  .primary-nav ul {
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .primary-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    color: var(--color-plum-soft);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .primary-nav a:hover {
    color: var(--color-terracotta-dark);
  }

  .header-icons {
    display: flex;
    align-items: center;
    /* Tighter than the surrounding whitespace on purpose -- the cluster
       is right-anchored (justify-self: end on mobile, last flex item on
       desktop), so shrinking this gap pulls the bookmark icon in toward
       the search icon rather than shifting search. That reads as one
       paired control, distinct from the open space around the
       centered logo, instead of hamburger/logo/bookmark/search all
       looking like evenly spaced siblings. */
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .search-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border: none;
    border-radius: 50%;
    background: transparent;
    /* Neutral grey, not the plum-tinted --color-plum-soft — a chrome
       control like this shouldn't compete with the page's actual
       content for attention. */
    color: var(--color-gray-50);
    cursor: pointer;
    flex-shrink: 0;
  }

  .search-toggle:hover {
    color: var(--color-terracotta-dark);
  }

  .bookmark-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    /* Neutral grey, not the plum-tinted --color-plum-soft — a chrome
       control like this shouldn't compete with the page's actual
       content for attention. */
    color: var(--color-gray-50);
    flex-shrink: 0;
  }

  .bookmark-link:hover {
    color: var(--color-terracotta-dark);
    text-decoration: none;
  }

  .bookmark-count {
    position: absolute;
    top: 0.05rem;
    right: 0.05rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.1rem;
    height: 1.1rem;
    padding: 0 0.25rem;
    border-radius: 999px;
    background: var(--color-terracotta);
    color: var(--color-white);
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1;
  }

  /* Without this, the class rule above (author-origin, normal weight)
     outranks the UA stylesheet's `[hidden] { display: none }` (also
     author-normal-beats-UA regardless of selector specificity), so toggling
     the `hidden` attribute from JS would otherwise be silently ignored. */
  .bookmark-count[hidden] {
    display: none;
  }

  .header-search-bar {
    border-top: 1px solid var(--color-border);
    background: var(--color-cream);
  }

  .header-search-form {
    display: flex;
    gap: 0.6rem;
    padding: 1rem 1.5rem;
  }

  .header-search-form input {
    flex: 1;
    min-width: 0;
    padding: 0.7em 1.1em;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-white);
    font-family: var(--font-body);
    /* iOS/Android mobile browsers auto-zoom the whole page on focus for
       any text input under 16px, then leave it pannable until the user
       zooms back out manually -- 1rem is the floor that avoids it. */
    font-size: 1rem;
    color: var(--color-plum);
  }

  .header-search-form input:focus-visible {
    outline: 3px solid var(--color-terracotta);
  }

  .mobile-menu {
    background: var(--color-cream);
    border-top: 1px solid var(--color-border);
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.5rem 1rem;
    display: flex;
    flex-direction: column;
  }

  .mobile-menu li {
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-menu li:last-child {
    border-bottom: none;
  }

  .mobile-menu a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 0.25rem;
    color: var(--color-plum-soft);
    font-weight: 500;
  }

  .mobile-menu a:hover {
    color: var(--color-terracotta-dark);
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .primary-nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    /* With the full nav hidden, .header-inner would otherwise just be
       three items packed flex-start — hamburger and logo huddled on the
       left with a lot of dead space before the icons, and the logo
       nowhere near the visual center. A 1fr/auto/1fr grid keeps the
       hamburger pinned to the left edge and the icon cluster pinned to
       the right edge (via the two equal flexible columns) while the
       logo, sized to its own content, lands truly centered between them
       regardless of the two clusters' differing widths. */
    .header-inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 0.75rem;
    }

    .header-left {
      justify-self: start;
    }

    .logo {
      justify-self: center;
    }

    .header-icons {
      justify-self: end;
    }
  }

  @media (min-width: 961px) {
    .mobile-menu {
      display: none !important;
    }
  }

  /* The header is deliberately always light, regardless of the visitor's
     browser/OS theme — see global.css's color-scheme: light. A previous
     attempt to make it dark-mode-responsive (dark background + light
     logo/hamburger/nav under prefers-color-scheme: dark) was reverted:
     real devices handle dark-mode reporting too inconsistently for it to
     be worth the risk — one browser applied it in a way that visibly
     shifted the header layout, another (Brave, via its own forced-dark
     override rather than a real dark preference) applied the dark
     background but left the hamburger bars dark too, making them
     unreadable. A single, always-light header sidesteps that whole class
     of cross-browser bug. */
</style>

<script>
  import { getBookmarks, onBookmarksChange } from '../lib/bookmarks';

  const bookmarkCount = document.querySelector<HTMLElement>('[data-bookmark-count]');
  if (bookmarkCount) {
    function updateBookmarkCount() {
      const count = getBookmarks().length;
      bookmarkCount!.hidden = count === 0;
      bookmarkCount!.textContent = String(count);
    }
    updateBookmarkCount();
    onBookmarksChange(updateBookmarkCount);
  }

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  if (toggle && menu) {
    function closeMenu() {
      menu!.hidden = true;
      toggle!.setAttribute('aria-expanded', 'false');
      toggle!.setAttribute('aria-label', 'Open menu');
    }

    function openMenu() {
      menu!.hidden = false;
      toggle!.setAttribute('aria-expanded', 'true');
      toggle!.setAttribute('aria-label', 'Close menu');
    }

    toggle.addEventListener('click', () => {
      if (menu!.hidden) openMenu();
      else closeMenu();
    });

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && !menu!.hidden) {
        closeMenu();
        toggle!.focus();
      }
    });

    document.addEventListener('click', (e: MouseEvent) => {
      if (menu!.hidden) return;
      const target = e.target as Node;
      if (!menu!.contains(target) && !toggle!.contains(target)) {
        closeMenu();
      }
    });
  }

  const searchToggle = document.querySelector<HTMLButtonElement>('[data-search-toggle]');
  const searchBar = document.querySelector<HTMLElement>('[data-header-search-bar]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');

  if (searchToggle && searchBar && searchInput) {
    function closeSearch() {
      searchBar!.hidden = true;
      searchToggle!.setAttribute('aria-expanded', 'false');
      searchToggle!.setAttribute('aria-label', 'Search');
    }

    function openSearch() {
      searchBar!.hidden = false;
      searchToggle!.setAttribute('aria-expanded', 'true');
      searchToggle!.setAttribute('aria-label', 'Close search');
      searchInput!.focus();
    }

    searchToggle.addEventListener('click', () => {
      if (searchBar!.hidden) openSearch();
      else closeSearch();
    });

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && !searchBar!.hidden) {
        closeSearch();
        searchToggle!.focus();
      }
    });

    document.addEventListener('click', (e: MouseEvent) => {
      if (searchBar!.hidden) return;
      const target = e.target as Node;
      if (!searchBar!.contains(target) && !searchToggle!.contains(target)) {
        closeSearch();
      }
    });
  }
</script>
