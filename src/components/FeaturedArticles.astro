---
// Homepage featured section: a big 2/3-width lead article alongside two
// smaller 1/3-width articles on desktop. On mobile the same 3 articles
// stack one after another (see the media query below) — there's no
// separate mobile-only content, just a different layout of the same set.
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
  articles: CollectionEntry<'articles'>[];
}

const { articles } = Astro.props;
const [main, ...side] = articles;
---

{main && (
  <div class="featured-grid">
    <a href={withBase(`/articles/${main.slug}`)} class="featured-card featured-main">
      <div class="featured-media">
        {main.data.heroImage && (
          <img
            src={main.data.heroImage.src}
            alt={main.data.heroImageAlt ?? main.data.title}
            loading="eager"
          />
        )}
        <div class="featured-scrim"></div>
      </div>
      <div class="featured-copy">
        <span class="tag">{main.data.category}</span>
        <h2>{main.data.title}</h2>
        <p>{main.data.description}</p>
      </div>
    </a>

    {side.length > 0 && (
      <div class="featured-side">
        {side.map((article) => (
          <a href={withBase(`/articles/${article.slug}`)} class="featured-card featured-side-item">
            <div class="featured-media">
              {article.data.heroImage && (
                <img
                  src={article.data.heroImage.src}
                  alt={article.data.heroImageAlt ?? article.data.title}
                  loading="lazy"
                />
              )}
              <div class="featured-scrim"></div>
            </div>
            <div class="featured-copy featured-copy-sm">
              <span class="tag">{article.data.category}</span>
              <h3>{article.data.title}</h3>
              <p>{article.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
)}

<style>
  .featured-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
  }

  .featured-card {
    position: relative;
    display: block;
    color: #fff;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .featured-card:hover {
    text-decoration: none;
  }

  /* The image sits in its own fixed-height box so the excerpt below is
     free to grow to fit its full text — the excerpt is in normal flow,
     not overlaid on top of the image, so nothing gets clipped no matter
     how long a description runs. */
  .featured-media {
    position: relative;
    overflow: hidden;
  }

  .featured-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.15) 55%, rgba(0, 0, 0, 0) 100%);
  }

  .featured-copy {
    position: relative;
    /* Pulls the copy block up to overlap the bottom of the image (the
       previous overlaid look), while staying in normal flow so it can
       push the card taller instead of being clipped when the excerpt
       runs long. */
    margin-top: -5.5rem;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    /* Solid, not translucent — this box can now extend below the image
       onto the plain card background, and needs to stay readable there
       too, not just over the photo. */
    background: var(--color-plum);
  }

  .featured-copy .tag {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
  }

  .featured-copy h2 {
    color: #fff;
    margin: 0.5em 0 0.3em;
    font-size: clamp(1.3rem, 1.1rem + 1.2vw, 2rem);
  }

  .featured-copy p {
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  .featured-main .featured-media {
    /* Scales with viewport instead of staying a fixed height, so the
       hero grows on wide screens rather than leaving a fixed-size image
       surrounded by ever-more empty margin as the window widens. */
    min-height: clamp(420px, 37.5vw, 580px);
  }

  .featured-side {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .featured-side-item {
    flex: 1;
  }

  .featured-side-item .featured-media {
    min-height: clamp(200px, 17vw, 280px);
  }

  .featured-copy-sm {
    margin-top: -3.5rem;
    padding: 1.1rem;
  }

  .featured-copy-sm h3 {
    color: #fff;
    margin: 0.4em 0 0;
    font-size: 1rem;
  }

  .featured-copy-sm p {
    margin: 0.3em 0 0;
    font-size: 0.82rem;
  }

  @media (max-width: 640px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }

    .featured-main .featured-media {
      min-height: 260px;
    }

    .featured-side-item .featured-media {
      min-height: 220px;
    }
  }
</style>
