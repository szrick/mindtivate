---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
---

<BaseLayout title="Check your inbox" description="Confirm your Mindtivate Insights subscription.">
  <section class="section container prose-page">
    <p class="eyebrow">Mindtivate Insights</p>
    <h1>Almost there</h1>
    <p>
      We've sent a confirmation link to the email you entered — click it
      to complete your signup. If you don't see it in a minute or two,
      check your spam folder. In the meantime,
      <a href={withBase('/articles')}>browse our latest articles</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .prose-page {
    max-width: 640px;
  }
</style>
