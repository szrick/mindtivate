---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with the Mindtivate team.">
  <section class="section container prose-page">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p>
      Questions, corrections, partnership inquiries, or a topic you'd like
      us to research? Email us and we'll get back to you.
    </p>
    <p>
      <a href="mailto:hello@mindtivate.com" class="btn btn-primary">hello@mindtivate.com</a>
    </p>
    <p>
      Found something inaccurate in an article? Please include the article
      URL — we take corrections seriously and will review promptly.
    </p>
  </section>
</BaseLayout>

<style>
  .prose-page {
    max-width: 640px;
  }
</style>
