---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/HeroSlider.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { CATEGORIES, toCategorySlug } from '../lib/categories';
import { withBase } from '../lib/url';

const allArticles = await getCollection(
  'articles',
  ({ data }) => data.status === 'published' && !data.draft && Boolean(data.heroImage),
);
const sliderArticles = allArticles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout
  title="Mindtivate — Fitness, Nutrition & Mental Health for Women"
  description="Evidence-checked fitness, nutrition, and mental-health guidance for women, sourced from the questions real communities are actually asking."
>
  <section class="section container slider-section">
    {sliderArticles.length > 0 ? (
      <HeroSlider articles={sliderArticles} />
    ) : (
      <p class="empty-state">New articles are in research right now — check back soon.</p>
    )}
  </section>

  <section class="section container">
    <p class="eyebrow">Explore by topic</p>
    <h2>Find what you're working on</h2>
    <div class="category-grid">
      {CATEGORIES.map((c) => (
        <a href={withBase(`/category/${toCategorySlug(c.label)}`)} class="category-card card">
          <h3>{c.label}</h3>
          <p>{c.blurb}</p>
        </a>
      ))}
    </div>
  </section>

  <div class="section container">
    <NewsletterSignup />
  </div>
</BaseLayout>

<style>
  .slider-section {
    padding-top: clamp(1.5rem, 3vw, 3rem);
  }

  .empty-state {
    margin: 0;
    color: var(--color-plum-soft);
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .category-card {
    display: block;
    padding: 1.5rem;
    color: inherit;
  }

  .category-card:hover {
    text-decoration: none;
  }

  .category-card h3 {
    margin-bottom: 0.3em;
    color: var(--color-terracotta-dark);
  }

  .category-card p {
    font-size: 0.92rem;
    margin: 0;
  }
</style>
