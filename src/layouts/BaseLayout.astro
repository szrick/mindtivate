---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  noindex?: boolean;
}

const { title, description, image, article = false, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon-light.svg')} media="(prefers-color-scheme: dark)" />
    <!-- Moved out of global.css's old `@import url(...)` -- see the comment
         there. preconnect opens both font-CDN connections (DNS + TCP + TLS)
         as soon as the browser starts parsing <head>, instead of waiting
         to discover them only after downloading and parsing the bundled
         CSS. crossorigin is required on the gstatic preconnect even though
         this page itself isn't cross-origin with it -- font fetches are
         always CORS requests, and a preconnect without crossorigin opens a
         connection the browser then can't reuse for the actual fetch. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- A plain <link rel="stylesheet"> here still blocks first paint on a
         cross-origin fetch, even with the preconnects above (PageSpeed
         Insights flagged this specifically: "Render-blocking requests",
         ~1.2s estimated savings on mobile). media="print" makes the browser
         treat it as non-blocking for an on-screen render (it doesn't match
         the current media type) while still fetching it at normal priority;
         onload flips it to "all" once it's ready, applying the real fonts.
         Paired with this URL's existing `display=swap`, text renders
         immediately in the fallback font and swaps to the web font when it
         arrives, instead of blocking that first render on the font CSS
         round-trip. <noscript> covers browsers with JS disabled, where the
         onload handler would otherwise never fire. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Lato:wght@400;700;900&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Lato:wght@400;700;900&display=swap" />
    </noscript>
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} image={image} article={article} noindex={noindex} />
    {import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_BEACON_TOKEN}"}`}
      />
    )}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
