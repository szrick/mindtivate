---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import BookmarkButton from '../components/BookmarkButton.astro';
import ProductCallout from '../components/ProductCallout.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import InlineNewsletter from '../components/InlineNewsletter.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { getEntries, getEntry } from 'astro:content';
import { toCategorySlug } from '../lib/categories';
import { withBase } from '../lib/url';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const {
  title,
  seoTitle,
  description,
  pubDate,
  updatedDate,
  category,
  heroImage,
  heroImageAlt,
  heroImageSource,
  heroImagePhotographer,
  heroImagePhotographerUrl,
  heroImageSourceUrl,
  author,
  featuredProducts,
} = article.data;

const authorEntry = author ? await getEntry(author) : null;
const products = featuredProducts?.length ? await getEntries(featuredProducts) : [];

const formattedDate = pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const categorySlug = toCategorySlug(category);

const articleUrl = new URL(withBase(`/articles/${article.slug}/`), Astro.site).toString();
const shareImageUrl = heroImage ? new URL(heroImage.src, Astro.site).toString() : undefined;
---

<BaseLayout title={seoTitle ?? title} description={description} image={heroImage?.src} article>
  <article class="section container article">
    <header class="article-header">
      <a href={withBase(`/category/${categorySlug}`)} class="tag">{category}</a>
      <h1>{title}</h1>
      <p class="article-meta">
        {authorEntry && <span>By {authorEntry.data.name}</span>}
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {updatedDate && <span>(updated {updatedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })})</span>}
      </p>
    </header>

    {heroImage && (
      <figure class="article-hero-figure">
        {/* quality={75}, here and on every other content-photo <Image> site-wide:
            Sharp's default WebP quality (80) was flagged by PageSpeed Insights'
            "Improve image delivery" insight -- 75 shaves ~14% off file size with
            no visible difference at the sizes these actually render (verified by
            comparing quality 65/70/75/80 side by side on a real hero photo). */}
        <Image
          src={heroImage}
          alt={heroImageAlt ?? title}
          class="article-hero"
          widths={[400, 800, 1200, 1600]}
          sizes={`(min-width: 1120px) 1120px, 100vw`}
          loading="eager"
          fetchpriority="high"
          quality={75}
        />
        {heroImageSource && (
          <figcaption class="hero-credit">
            Photo by{' '}
            {heroImagePhotographerUrl ? (
              <a href={heroImagePhotographerUrl} target="_blank" rel="noopener noreferrer">{heroImagePhotographer}</a>
            ) : (
              heroImagePhotographer
            )}{' '}
            on{' '}
            {heroImageSourceUrl ? (
              <a href={heroImageSourceUrl} target="_blank" rel="noopener noreferrer">{heroImageSource}</a>
            ) : (
              heroImageSource
            )}
          </figcaption>
        )}
      </figure>
    )}

    <BookmarkButton
      slug={article.slug}
      title={title}
      category={category}
      heroImage={heroImage?.src}
      pubDate={pubDate.toISOString()}
    />

    {products.length > 0 && <AffiliateDisclosure />}

    <div class="prose">
      <slot />
    </div>

    <InlineNewsletter />

    {products.length > 0 && (
      <section class="article-products">
        <h2>Mentioned in this article</h2>
        {products.map((product) => <ProductCallout product={product} />)}
      </section>
    )}

    <ShareButtons title={title} url={articleUrl} imageUrl={shareImageUrl} />
  </article>

  <RelatedArticles article={article} />

  <div class="container">
    <NewsletterBox />
  </div>
</BaseLayout>

<style>
  .article {
    max-width: 720px;
  }

  .article-header {
    margin-bottom: 1.5rem;
  }

  .article-meta {
    display: flex;
    gap: 0.9em;
    flex-wrap: wrap;
    font-size: 0.88rem;
    color: var(--color-plum-soft);
    margin-top: 0.6em;
  }

  .article-hero-figure {
    margin: 1.5rem 0 2rem;
  }

  .article-hero {
    width: 100%;
    /* Without this, the box's height comes from the <img> element's own
       width/height HTML attributes (which astro:assets sets to the
       source photo's full intrinsic size, e.g. 1880x1253, not a size
       tied to this box) applied as a presentational hint -- and since
       that gives `height` a definite value, aspect-ratio's auto-height
       computation never kicks in (it only applies when height is auto).
       The real symptom: this box rendered at the photo's raw intrinsic
       pixel height (over 1000px) instead of a 16:9 box scaled to the
       container width. */
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin: 0;
  }

  .hero-credit {
    margin: 0.4rem 0 0;
    font-size: 0.78rem;
    color: var(--color-gray-50);
  }

  .article-products {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
</style>
